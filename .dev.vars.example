NEXTJS_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
INSIGHTS_PROVIDER=local
LEAD_SUBMISSION_MODE=disabled
RATE_LIMIT_PROVIDER=memory
AUTH_RATE_LIMIT_PROVIDER=memory
PUBLISH_SCHEDULER_PROVIDER=disabled
CLOUDINARY_UPLOAD_FOLDER=taskcover/insights

# Put local-only secrets in .dev.vars, never in this example file.
DATABASE_URL=
AUTH_SESSION_SECRET=
PREVIEW_TOKEN_SECRET=
PUBLISH_CRON_SECRET=
RESEND_API_KEY=
HUBSPOT_PRIVATE_APP_TOKEN=
TURNSTILE_SECRET_KEY=
CLOUDINARY_API_SECRET=
