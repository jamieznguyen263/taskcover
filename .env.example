# Lead funnel mode. Use "disabled" until a real delivery adapter is configured.
# Supported values today: disabled, test. "test" enables a safe acceptance adapter for QA only.
LEAD_SUBMISSION_MODE=disabled

# Default operational recipient for future notification adapters.
LEAD_NOTIFICATION_EMAIL=business@taskcover.com

# Optional server-side webhook adapters. Leave blank until a trusted provider endpoint exists.
LEAD_WEBHOOK_URL=
CRM_WEBHOOK_URL=

# Future calendar adapter. The current /book-a-call form creates a strategy-call request only.
CALENDAR_PROVIDER=disabled
CALENDAR_BOOKING_URL=

# Optional Cloudflare Turnstile. The site key may be rendered publicly; the secret must stay server-side.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Rate limiting. "memory" is suitable for development and single-instance QA only.
# Production should use a durable edge-safe store such as Cloudflare KV, Durable Objects, or Redis.
RATE_LIMIT_PROVIDER=memory
RATE_LIMIT_NAMESPACE=taskcover-leads

# Admin content operating system.
# Leave INSIGHTS_PROVIDER=local until PostgreSQL migrations/imports are complete.
DATABASE_URL=
INSIGHTS_PROVIDER=local
AUTH_SESSION_SECRET=
APP_URL=http://localhost:3000

# Cloudinary production uploads. Production upload UI is unavailable until all are configured.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=taskcover/insights

# Secure scheduled publishing.
PUBLISH_CRON_SECRET=
PUBLISH_SCHEDULER_PROVIDER=disabled

# Admin auth rate limiting. Memory is development/single-instance QA only.
AUTH_RATE_LIMIT_PROVIDER=memory
AUTH_RATE_LIMIT_NAMESPACE=taskcover-admin-auth

# Reserved for future scoped preview links.
PREVIEW_TOKEN_SECRET=
