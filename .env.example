# Application origins.
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Lead funnel mode. Production acceptance requires durable Neon storage.
LEAD_SUBMISSION_MODE=disabled

# Resend transactional email. Put real values in .env.local, .dev.vars, or Cloudflare secrets.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Taskcover Agency <business@taskcover.com>
RESEND_REPLY_TO_EMAIL=business@taskcover.com
LEAD_NOTIFICATION_EMAIL=business@taskcover.com

# HubSpot Private App CRM sync.
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_PIPELINE_ID=
HUBSPOT_NEW_LEAD_STAGE_ID=

# Cal.com post-submission booking CTA. Do not include PII query params.
CALCOM_BOOKING_URL=

# Consent-aware analytics and SEM measurement. Leave empty until provider review.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GTM_ENABLED=false
NEXT_PUBLIC_ANALYTICS_DEBUG=false
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_FREE_AUDIT_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_STRATEGY_CALL_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_CONTACT_LABEL=
NEXT_PUBLIC_MICROSOFT_UET_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=

# Optional Cloudflare Turnstile. The site key may be rendered publicly; the secret must stay server-side.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=
TURNSTILE_EXPECTED_ACTION=lead-submit

# Rate limiting. "memory" is development-only. Production uses Cloudflare Rate Limiting and/or Durable Objects.
RATE_LIMIT_PROVIDER=memory
RATE_LIMIT_NAMESPACE=taskcover-leads

# Admin content operating system.
# Leave INSIGHTS_PROVIDER=local until PostgreSQL migrations/imports are complete.
DATABASE_URL=
DATABASE_TARGET=development
# OpenNext/Cloudflare local preview maps the HYPERDRIVE binding to this variable.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=
INSIGHTS_PROVIDER=local
AUTH_SESSION_SECRET=
PREVIEW_TOKEN_SECRET=

# Cloudinary production uploads. Production upload UI is unavailable until all are configured.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=taskcover/insights

# Secure scheduled publishing.
PUBLISH_CRON_SECRET=
PUBLISH_SCHEDULER_PROVIDER=disabled

# Admin auth rate limiting. Memory is development/single-instance QA only.
AUTH_RATE_LIMIT_PROVIDER=memory
AUTH_RATE_LIMIT_NAMESPACE=taskcover-admin-auth

# Reserved for future scoped preview links.
