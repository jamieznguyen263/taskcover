{
  "name": "taskcover",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview:cloudflare": "tsx scripts/cloudflare-preview-check.ts && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cf:dry-run": "wrangler deploy --dry-run --env=\"\" --outdir .wrangler/dry-run",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:status": "tsx scripts/db-status.ts",
    "db:verify": "tsx scripts/db-verify.ts",
    "admin:create": "tsx scripts/admin-create.ts",
    "admin:verify": "tsx scripts/admin-verify.ts",
    "insights:import": "tsx scripts/insights-import.ts",
    "insights:verify-database": "tsx scripts/insights-verify-database.ts",
    "leads:process": "tsx scripts/leads-process.ts",
    "leads:smoke": "tsx scripts/leads-smoke.ts",
    "integrations:test-resend": "tsx scripts/integrations-test-resend.ts",
    "integrations:test-hubspot": "tsx scripts/integrations-test-hubspot.ts",
    "integrations:test-calcom": "tsx scripts/integrations-test-calcom.ts",
    "integrations:test-turnstile": "tsx scripts/integrations-test-turnstile.ts",
    "integrations:test-cloudinary": "tsx scripts/integrations-test-cloudinary.ts",
    "rate-limits:verify": "tsx scripts/rate-limits-verify.ts",
    "scheduler:verify": "tsx scripts/scheduler-verify.ts",
    "production:check": "tsx scripts/production-check.ts",
    "production:predeploy": "npm run production:check && npm run test && npm run lint && npm run typecheck && npm run build && npm run build:cloudflare && npm run cf:dry-run",
    "smoke:deployment": "tsx scripts/smoke-deployment.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.1",
    "@opentelemetry/api": "^1.9.1",
    "@radix-ui/react-accordion": "^1.2.14",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.15",
    "@tiptap/extension-link": "^3.27.1",
    "@tiptap/extension-placeholder": "^3.27.1",
    "@tiptap/extension-table": "^3.27.1",
    "@tiptap/extension-table-cell": "^3.27.1",
    "@tiptap/extension-table-header": "^3.27.1",
    "@tiptap/extension-table-row": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "hash-wasm": "^4.12.0",
    "lucide-react": "^1.22.0",
    "motion": "^12.42.0",
    "next": "16.2.9",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.9.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "vitest": "^4.1.9",
    "wrangler": "^4.107.0"
  }
}
