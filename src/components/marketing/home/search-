"use client";

import * as React from "react";
import { motion, useReducedMotion } from "motion/react";
import { Container } from "@/components/marketing/shared/container";
import { Eyebrow } from "@/components/marketing/shared/section-header";
import { GradientBorderCard } from "@/components/marketing/shared/gradient-border-card";
import { cn } from "@/lib/utils";

/**
 * Search Ecosystem Map.
 *
 * Renders the fragmented modern search landscape as an interactive network:
 * a central "Your brand" hub with satellite surfaces (Google, AI, Local, etc.)
 * connected by animated SVG lines with a knowledge-graph / Obsidian feel.
 *
 * Improvements over V1:
 *  - Every node has a visible label + icon glyph.
 *  - Connection lines use animated particle/dash flow toward the hub.
 *  - Hovering a node highlights its line and updates the detail panel.
 *  - Bright, premium, clean — never cyberpunk/neon.
 *
 * On mobile, falls back to a compact horizontal node selector.
 */

type Surface = {
  id: string;
  label: string;
  short: string;
  note: string;
  glyph: string;
  /** Position on the ring (0-360 degrees, 0 = top) */
  angle: number;
};

const surfaces: Surface[] = [
  { id: "google", label: "Google Organic", short: "Google", note: "Core SERP visibility and demand capture.", glyph: "G", angle: 0 },
  { id: "ai", label: "AI Overviews", short: "AI", note: "AI-assisted discovery inside Google results.", glyph: "AI", angle: 40 },
  { id: "llm", label: "ChatGPT & LLMs", short: "LLMs", note: "Generative answers surfaces and citations.", glyph: "{ }", angle: 80 },
  { id: "local", label: "Local Pack", short: "Local", note: "Maps and local pack presence.", glyph: "◉", angle: 120 },
  { id: "reviews", label: "Review Platforms", short: "Reviews", note: "Trust and reputation signals.", glyph: "★", angle: 160 },
  { id: "youtube", label: "YouTube", short: "YouTube", note: "Video search and discovery.", glyph: "▶", angle: 200 },
  { id: "forums", label: "Reddit & Forums", short: "Forums", note: "Community search and discussion.", glyph: "✦", angle: 240 },
  { id: "press", label: "Publications", short: "Press", note: "Editorial authority and coverage.", glyph: "❡", angle: 280 },
  { id: "landing", label: "Landing Pages", short: "Landing", note: "Conversion-intent owned surfaces.", glyph: "◆", angle: 320 },
];

// Ring geometry (viewBox 0 0 460 460, center 230,230)
const CX = 230;
const CY = 230;
const RING_RADIUS = 160;

function polarToCartesian(cx: number, cy: number, r: number, angleDeg: number) {
  const rad = ((angleDeg - 90) * Math.PI) / 180;
  return { x: cx + r * Math.cos(rad), y: cy + r * Math.sin(rad) };
}

export function SearchEcosystemMap({
  eyebrow,
  title,
  titleId,
  description,
  message,
  className,
}: {
  eyebrow: string;
  title: React.ReactNode;
  titleId: string;
  description: React.ReactNode;
  message: React.ReactNode;
  className?: string;
}) {
  const reduceMotion = useReducedMotion();
  const [activeId, setActiveId] = React.useState<string | null>(null);

  const lineVariants = {
    hidden: { pathLength: 0, opacity: 0 },
    visible: (i: number) => ({
      pathLength: 1,
      opacity: 0.5,
      transition: reduceMotion
        ? { duration: 0 }
        : { duration: 0.6, delay: 0.2 + i * 0.05, ease: "easeOut" as const },
    }),
  };

  const nodeVariants = {
    hidden: { opacity: 0, scale: reduceMotion ? 1 : 0.6 },
    visible: (i: number) => ({
      opacity: 1,
      scale: 1,
      transition: reduceMotion ? { duration: 0 } : { duration: 0.4, delay: 0.3 + i * 0.05 },
    }),
  };

  const active = activeId ? surfaces.find((s) => s.id === activeId) : null;

  return (
    <Container className={cn("flex flex-col gap-12", className)}>
      <div className="flex max-w-2xl flex-col gap-4">
        <Eyebrow>{eyebrow}</Eyebrow>
        <h2
          id={titleId}
          className="text-balance text-3xl font-semibold tracking-tight text-graphite sm:text-4xl lg:text-[2.75rem] lg:leading-[1.1]"
        >
          {title}
        </h2>
        <p className="text-pretty text-base leading-relaxed text-secondary sm:text-lg">
          {description}
        </p>
      </div>

      <div className="grid items-center gap-10 lg:grid-cols-[1fr_1.1fr]">
        {/* Network map (desktop) / selector (mobile) */}
        <div className="order-2 lg:order-1">
          {/* Desktop SVG network */}
          <div className="hidden lg:block">
            <svg viewBox="0 0 460 460" className="mx-auto w-full max-w-lg" role="img" aria-labelledby="ecosystem-map-title">
              <title id="ecosystem-map-title">Search ecosystem network map</title>
              <defs>
                <radialGradient id="hubGrad">
                  <stop offset="0%" stopColor="#10E66A" stopOpacity="0.22" />
                  <stop offset="100%" stopColor="#197DB4" stopOpacity="0.08" />
                </radialGradient>
                <linearGradient id="flowGrad" x1="0" y1="0" x2="1" y2="0">
                  <stop offset="0%" stopColor="#10E66A" stopOpacity="0.1" />
                  <stop offset="50%" stopColor="#188AAC" stopOpacity="0.8" />
                  <stop offset="100%" stopColor="#10E66A" stopOpacity="0.1" />
                </linearGradient>
              </defs>

              {/* Connection lines + animated particles */}
              {surfaces.map((s, i) => {
                const pos = polarToCartesian(CX, CY, RING_RADIUS, s.angle);
                const isActive = activeId === s.id;
                return (
                  <g key={`line-${s.id}`}>
                    <motion.line
                      custom={i}
                      variants={lineVariants}
                      initial="hidden"
                      animate="visible"
                      x1={CX}
                      y1={CY}
                      x2={pos.x}
                      y2={pos.y}
                      stroke={isActive ? "#10E66A" : "#188AAC"}
                      strokeWidth={isActive ? 2 : 1}
                      style={{ opacity: isActive ? 0.9 : 0.35 }}
                    />
                    {/* Animated particle flowing toward hub */}
                    {!reduceMotion && (
                      <motion.circle
                        r={isActive ? 3 : 2}
                        fill={isActive ? "#10E66A" : "#188AAC"}
                        initial={{ cx: pos.x, cy: pos.y, opacity: 0 }}
                        animate={{
                          cx: [pos.x, CX],
                          cy: [pos.y, CY],
                          opacity: [0, 1, 0],
                        }}
                        transition={{
                          duration: 2.4,
                          delay: i * 0.25,
                          repeat: Infinity,
                          ease: "easeInOut",
                        }}
                      />
                    )}
                  </g>
                );
              })}

              {/* Center hub */}
              <motion.g
                initial={{ opacity: 0, scale: reduceMotion ? 1 : 0.5 }}
                animate={{ opacity: 1, scale: 1 }}
                transition={{ duration: 0.4 }}
              >
                <circle cx={CX} cy={CY} r="44" fill="url(#hubGrad)" />
                <circle cx={CX} cy={CY} r="44" fill="none" stroke="#188AAC" strokeWidth="1" opacity="0.3" />
                {!reduceMotion && (
                  <motion.circle
                    cx={CX}
                    cy={CY}
                    r="44"
                    fill="none"
                    stroke="#10E66A"
                    strokeWidth="1"
                    initial={{ opacity: 0.3, scale: 1 }}
                    animate={{ opacity: [0.3, 0, 0.3], scale: [1, 1.4, 1] }}
                    transition={{ duration: 3, repeat: Infinity, ease: "easeInOut" }}
                    style={{ transformOrigin: "center" }}
                  />
                )}
                <text x={CX} y={CY - 4} textAnchor="middle" className="fill-graphite text-[11px] font-bold">
                  Your
                </text>
                <text x={CX} y={CY + 9} textAnchor="middle" className="fill-graphite text-[11px] font-bold">
                  Brand
                </text>
              </motion.g>

              {/* Satellite nodes with labels */}
              {surfaces.map((s, i) => {
                const pos = polarToCartesian(CX, CY, RING_RADIUS, s.angle);
                const isActive = activeId === s.id;
                // Push labels outward from center
                const labelPos = polarToCartesian(CX, CY, RING_RADIUS + 34, s.angle);
                return (
                  <motion.g
                    key={s.id}
                    custom={i}
                    variants={nodeVariants}
                    initial="hidden"
                    animate="visible"
                    onMouseEnter={() => setActiveId(s.id)}
                    onMouseLeave={() => setActiveId(null)}
                    className="cursor-pointer"
                  >
                    {isActive && (
                      <circle cx={pos.x} cy={pos.y} r="20" fill="none" stroke="#10E66A" strokeWidth="1" opacity="0.4" />
                    )}
                    <circle
                      cx={pos.x}
                      cy={pos.y}
                      r={isActive ? 16 : 14}
                      fill={isActive ? "#10E66A" : "#FFFFFF"}
                      stroke={isActive ? "#10E66A" : "#188AAC"}
                      strokeWidth="1.5"
                      className="transition-all"
                    />
                    <text
                      x={pos.x}
                      y={pos.y + 1}
                      textAnchor="middle"
                      dominantBaseline="middle"
                      className={cn("text-[10px] font-bold", isActive ? "fill-white" : "fill-brand-teal")}
                    >
                      {s.glyph}
                    </text>
                    <text
                      x={labelPos.x}
                      y={labelPos.y}
                      textAnchor="middle"
                      dominantBaseline="middle"
                      className={cn(
                        "text-[9px] font-semibold transition-colors",
                        isActive ? "fill-graphite" : "fill-muted"
                      )}
                    >
                      {s.short}
                    </text>
                  </motion.g>
                );
              })}
            </svg>
          </div>

          {/* Mobile horizontal node selector */}
          <div className="lg:hidden">
            <div className="mb-4 flex flex-wrap gap-2">
              {surfaces.map((s) => (
                <button
                  key={s.id}
                  type="button"
                  onClick={() => setActiveId(s.id)}
                  className={cn(
                    "inline-flex items-center gap-1.5 rounded-full border px-3 py-1.5 text-xs font-semibold transition-colors",
                    activeId === s.id
                      ? "border-brand-teal bg-brand-gradient text-white"
                      : "border-line bg-white text-secondary"
                  )}
                >
                  <span aria-hidden="true">{s.glyph}</span>
                  {s.short}
                </button>
              ))}
            </div>
          </div>
        </div>

        {/* Active surface detail / default message */}
        <div className="order-1 lg:order-2">
          <GradientBorderCard>
            <div className="flex flex-col gap-4">
              <div className="flex items-center gap-3">
                <span className="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-brand-gradient text-sm font-bold text-white">
                  {active ? active.glyph : "◎"}
                </span>
                <p className="text-sm font-semibold text-brand-teal">
                  {active ? active.label : "Nine surfaces. One system."}
                </p>
              </div>
              <p className="text-base leading-relaxed text-secondary">
                {active
                  ? active.note
                  : "Select or hover a node to see how each surface connects to your brand. Taskcover does not treat them as separate channels — they are one connected search growth system."}
              </p>
              <p className="border-t border-line-soft pt-4 text-base font-medium text-graphite">
                {message}
              </p>
            </div>
          </GradientBorderCard>
        </div>
      </div>
    </Container>
  );
}